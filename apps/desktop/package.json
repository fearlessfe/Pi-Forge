{
  "name": "@pi-desktop/renderer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open-source desktop foundation for building custom enterprise agents.",
  "author": {
    "name": "Pi Forge contributors",
    "email": "505380967@qq.com"
  },
  "homepage": "https://github.com/fearlessfe/Pi-Forge",
  "desktopName": "pi-forge.desktop",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "dev": "tsc -p tsconfig.electron.json && concurrently -k -s first \"vite\" \"wait-on tcp:4173 && VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron dist-electron/electron/main.js\"",
    "build": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false",
    "preview": "vite preview",
    "start": "electron dist-electron/electron/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-collapsible": "1.1.18",
    "@radix-ui/react-dropdown-menu": "2.1.22",
    "@radix-ui/react-select": "2.3.5",
    "@xterm/xterm": "^6.0.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "1.26.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "7.5.22",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "dev.piforge.desktop",
    "productName": "Pi Forge",
    "executableName": "pi-forge",
    "artifactName": "Pi-Forge-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@anthropic-ai/sandbox-runtime/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
