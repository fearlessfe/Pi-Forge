{
  "name": "@pi-forge/runtime-sdk",
  "version": "1.0.0",
  "description": "Transport-neutral SDK for building and consuming Pi Forge Runtime v1 agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "prebuild": "pnpm --filter @pi-forge/runtime-contracts build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @pi-forge/runtime-contracts build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @pi-forge/runtime-contracts build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "pnpm --filter @pi-forge/runtime-contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@pi-forge/runtime-contracts": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
